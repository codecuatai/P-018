  margin-bottom: 20px;
  transition: all 0.25s ease;
}

.payment-connect-box.momo-box {
  background: #fdf2f8;
  border-color: #fbcfe8;
}

.payment-connect-box.card-box {
  background: #f0f9ff;
  border-color: #bae6fd;
}

.payment-connect-box.bank-box {
  background: #f0fdf4;
  border-color: #bbf7d0;
}

.payment-connect-box.cash-box {
  background: #fffbeb;
  border-color: #fef08a;
}

.connect-header {
  display: flex;
  align-items: center;
