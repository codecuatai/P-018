  font-size: 0.9em;
  transition: all 0.2s;
}

.history-filters button:hover {
  border-color: var(--primary);
  color: var(--primary);
}

.history-filters button.active {
  background: var(--primary);
  color: white;
  border-color: var(--primary);
}

.history-content {
  padding-bottom: 24px;
}

.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  text-align: center;
  padding: 60px 20px;
  color: var(--text-muted);
  background: white;
  border-radius: var(--radius-md);
  border: 1px dashed var(--border-color);
  gap: 16px;
}

.empty-icon {
  color: #cbd5e1;
}

.history-list {
  display: flex;
  flex-direction: column;
  gap: 14px;
}

.history-card {
  border: 1px solid var(--border-color);
  border-radius: var(--radius-md);
  padding: 18px;
  background: white;
  box-shadow: var(--shadow-sm);
  display: grid;
  grid-template-columns: minmax(0, 1fr) 220px;
  gap: 18px;
  align-items: center;
  transition: border-color 0.2s, box-shadow 0.2s, transform 0.2s;
}

.history-card:hover {
  border-color: #bfdbfe;
  box-shadow: 0 12px 32px rgba(15, 23, 42, 0.08);
  transform: translateY(-1px);
}

.booking-main {
  min-width: 0;
  display: grid;
  grid-template-columns: 52px minmax(0, 1fr);
  gap: 14px;
  align-items: start;
}

.service-icon {
  width: 52px;
  height: 52px;
  border-radius: var(--radius-md);
  display: inline-flex;
  align-items: center;
  justify-content: center;
  color: var(--primary-dark);
  background: #eff6ff;
}

.service-icon.flight { color: #075985; background: #e0f2fe; }
.service-icon.bus { color: #047857; background: #d1fae5; }
.service-icon.train { color: #7c3aed; background: #f3e8ff; }
.service-icon.hotel { color: #b45309; background: #fef3c7; }
.service-icon.car { color: #334155; background: #f1f5f9; }

.booking-info {
  min-width: 0;
}

.booking-title-row {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 12px;
}

.booking-title-row h3 {
  margin: 0;
  font-size: 1.05rem;
  color: var(--text-main);
}

.booking-title-row span {
  display: block;
  margin-top: 4px;
  color: var(--text-muted);
  font-size: 0.86rem;
  font-weight: 600;
}

.status-badge {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  padding: 6px 10px;
  border-radius: var(--radius-full);
  font-size: 0.8rem;
  font-weight: 800;
  white-space: nowrap;
}

.status-badge.confirmed { background: #d1fae5; color: #065f46; }
.status-badge.completed { background: #e0f2fe; color: #075985; }
.status-badge.cancelled { background: #fee2e2; color: #991b1b; }
.status-badge.pending { background: #fef3c7; color: #92400e; }

.route-line {
  margin: 14px 0 12px;
  background: #f8fafc;
  border: 1px solid #eef2f7;
  border-radius: var(--radius-md);
  padding: 12px 14px;
  display: grid;
  grid-template-columns: minmax(0, 1fr) auto minmax(0, 1fr);
  gap: 12px;
  align-items: center;
  text-align: center;
}

.route-line strong {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.route-line svg {
  color: #94a3b8;
}

.booking-meta {
  display: flex;
  flex-wrap: wrap;
  gap: 8px 14px;
  color: var(--text-muted);
  font-size: 0.88rem;
  font-weight: 700;
}

.booking-meta span {
  display: inline-flex;
  align-items: center;
  gap: 6px;
}

.booking-side {
  border-left: 1px solid var(--border-color);
  padding-left: 18px;
  display: grid;
  justify-items: end;
  gap: 14px;
}

.booking-side > strong {
  color: var(--danger);
  font-size: 1.08rem;
}

.history-card-actions {
  display: flex;
  justify-content: flex-end;
  align-items: center;
  gap: 8px;
  flex-wrap: wrap;
}

.rating-display {
  color: var(--warning);
  font-weight: bold;
  display: inline-flex;
  gap: 2px;
}

.btn-primary,
.btn-secondary,
.btn-danger {
  padding: 8px 12px;
  border-radius: var(--radius-md);
  font-weight: 800;
  cursor: pointer;
  border: none;
  transition: all 0.2s;
  display: inline-flex;
  align-items: center;
  gap: 6px;
}

.btn-primary {
  background: var(--primary);
  color: white;
}

.btn-primary:hover {
  background: var(--primary-dark);
}

.btn-secondary {
  background: white;
  border: 1px solid var(--border-color);
  color: var(--text-main);
}

.btn-secondary:hover {
  background: var(--bg-color);
}

.btn-danger {
  background: #fee2e2;
  color: #991b1b;
}

.btn-danger:hover {
  background: #fecaca;
}

.modal-backdrop {
  position: fixed;
  inset: 0;
  background: rgba(15, 23, 42, 0.52);
  z-index: 30;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 20px;
}

.booking-modal {
  width: min(680px, 100%);
  max-height: min(760px, 92vh);
  overflow-y: auto;
  background: white;
  border-radius: var(--radius-md);
  box-shadow: 0 18px 60px rgba(15, 23, 42, 0.22);
  padding: 22px;
}

.booking-modal.compact {
  width: min(440px, 100%);
}

.modal-header {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  gap: 16px;
  border-bottom: 1px solid var(--border-color);
  padding-bottom: 14px;
  margin-bottom: 16px;
}

.modal-header h3 {
  margin: 0;
}

.modal-header p {
  color: var(--text-muted);
  margin: 4px 0 0;
}

.modal-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 12px;
}

.modal-grid div,
.modal-note {
  border: 1px solid var(--border-color);
  border-radius: var(--radius-md);
  padding: 12px;
}

.modal-grid span {
  display: block;
  color: var(--text-muted);
  font-size: 0.82rem;
  font-weight: 800;
  margin-bottom: 6px;
}

.modal-note {
  margin-top: 12px;
}

.modal-note p {
  margin: 8px 0 0;
  color: var(--text-muted);
}

.modal-actions {
  display: flex;
  justify-content: flex-end;
  gap: 10px;
  margin-top: 20px;
}

.rating-picker {
  display: flex;
  gap: 8px;
  margin-top: 14px;
}

.rating-picker button {
  border: 1px solid var(--border-color);
  background: white;
  color: #cbd5e1;
  border-radius: var(--radius-md);
  width: 44px;
  height: 44px;
  cursor: pointer;
  display: inline-flex;
  align-items: center;
  justify-content: center;
}

.rating-picker button.active {
  color: var(--warning);
  border-color: var(--warning);
  background: #fffbeb;
}

@media (max-width: 980px) {
  .history-hero,
  .history-card {
    grid-template-columns: 1fr;
  }

  .history-hero {
    display: grid;
  }

  .history-hero-total {
    min-width: 0;
  }

  .booking-side {
    border-left: none;
    border-top: 1px solid var(--border-color);
    padding-left: 0;
    padding-top: 14px;
    justify-items: start;
  }
}

@media (max-width: 720px) {
  .history-view {
    padding: 16px;
  }

  .history-summary {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .history-toolbar {
    grid-template-columns: 1fr;
  }

  .booking-main {
    grid-template-columns: 1fr;
  }

  .booking-title-row,
  .history-card-actions,
  .modal-actions {
    align-items: stretch;
    flex-direction: column;
  }

  .booking-title-row {
    display: grid;
  }

  .route-line {
    grid-template-columns: 1fr;
  }

  .history-card-actions button,
  .modal-actions button {
    width: 100%;
    justify-content: center;
  }

  .modal-grid {
    grid-template-columns: 1fr;
  }
}
