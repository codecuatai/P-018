  background: #f1f5f9;
}

.btn-save:disabled,
.btn-reset:disabled {
  background-color: #e2e8f0;
  border-color: #e2e8f0;
  color: #94a3b8;
  cursor: not-allowed;
  box-shadow: none;
}

.text-primary {
  color: var(--primary);
}

.form-row.three-cols {
  grid-template-columns: 2fr 1fr 1fr;
}

