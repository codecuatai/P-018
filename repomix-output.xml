<file path=".github/workflows/ci.yml">
name: CI

on:
  push:
    branches: [main, develop]
  pull_request:
    branches: [main]

jobs:
  python-services:
    runs-on: ubuntu-latest
    strategy:
      matrix:
        service: [apps/agent-service, services/ride-service, services/restaurant-service, services/healthcare-service, services/food-service]
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-python@v5
        with: { python-version: '3.11' }
      - name: Install service with test dependencies
        run: pip install "${{ matrix.service }}[dev]"
      - name: Lint agent
        if: matrix.service == 'apps/agent-service'
        run: ruff check apps/agent-service/src apps/agent-service/tests
      - name: Test service
        run: cd ${{ matrix.service }} && pytest tests -q

  gateway:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-node@v4
        with: { node-version: '22' }
      - run: corepack enable && pnpm --dir apps/api-gateway install --frozen-lockfile
      - run: corepack enable && pnpm --dir apps/api-gateway run lint && pnpm --dir apps/api-gateway test && pnpm --dir apps/api-gateway build

  web:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-node@v4
        with: { node-version: '20', cache: npm, cache-dependency-path: apps/web/package-lock.json }
      - run: cd apps/web && npm ci && npm run build

  compose:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - run: python scripts/validate-env-config.py
      - run: docker compose --env-file .env.example config --quiet
</file>

