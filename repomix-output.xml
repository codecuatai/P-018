  border: 1px solid #fecaca;
}

.alert-success {
  background-color: #ecfdf5;
  color: #047857;
  border: 1px solid #a7f3d0;
}

.profile-form {
  display: flex;
  flex-direction: column;
  gap: 18px;
  padding-bottom: 40px;
