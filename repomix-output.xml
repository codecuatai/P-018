  box-shadow: var(--shadow-sm);
}

.profile-header > div {
  flex: 1;
  min-width: 0;
}

.profile-header h2 {
  margin: 0;
  color: var(--text-main);
  font-size: 1.5rem;
}

.subtitle {
  color: var(--text-muted);
  margin: 4px 0 0 0;
  font-size: 0.95rem;
  font-weight: 600;
}

.btn-demo-fill {
  border: 1px solid var(--primary);
  background: #eff6ff;
  color: var(--primary-dark);
  border-radius: var(--radius-md);
  padding: 10px 14px;
  font-weight: 800;
  cursor: pointer;
  display: inline-flex;
  align-items: center;
  gap: 8px;
