  margin-bottom: 4px;
}

.summary-list strong {
  color: var(--text-main);
  font-size: 0.92rem;
  word-break: break-word;
}

.summary-card.compact strong {
  display: block;
  margin-bottom: 10px;
}

.summary-card ul {
  list-style: none;
  padding: 0;
