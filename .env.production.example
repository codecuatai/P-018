# ==============================================================================
# X-One Production Configuration Template (.env.production.example)
# Primary AI Platform (Core Gateway, Web UI, Agent Service, Core PostgreSQL)
# Domain services (Food, Ride, Restaurant, Healthcare) are in P-018-Service.
#
# HUONG DAN:
# 1. Copy file nay thanh .env tren may chu VPS:
#    cp .env.production.example /opt/xone/.env
#    chmod 600 /opt/xone/.env
# 2. Thay the tat ca cac secret bang khoa ngau nhien manh (dung: openssl rand -hex 32)
# 3. Khong bao gio commit file .env chua thong tin thuc te vao Git!
# ==============================================================================

# ---- Che do Production ----
APP_ENV=production
CORE_AUTO_MIGRATE=true

# ---- Khoa xac thuc & Bao mat he thong ----
INTERNAL_SERVICE_TOKEN=GENERATE_STRONG_INTERNAL_SERVICE_TOKEN_HERE
JWT_SECRET=GENERATE_STRONG_JWT_SECRET_AT_LEAST_32_CHARS_HERE

# ---- Vo hieu hoa tat ca cac tinh nang Test / Demo tren Production ----
DEMO_AUTH_ENABLED=false
DEMO_AUTH_EMAIL=
DEMO_AUTH_PASSWORD=
DEMO_AUTH_USER_ID=
AUTH_DEV_RESET_TOKEN_CAPTURE=false

# ---- Cau hinh thoi gian song Token (Seconds) ----
AUTH_ACCESS_TOKEN_TTL_SECONDS=900
AUTH_REFRESH_TOKEN_TTL_SECONDS=2592000
AUTH_REFRESH_REUSE_GRACE_SECONDS=10
AUTH_RESET_TOKEN_TTL_SECONDS=1800
AUTH_ISSUER=x-one
AUTH_AUDIENCE=x-one-web
AUTH_REFRESH_COOKIE_NAME=xone_refresh
UPSTREAM_TIMEOUT_MS=5000
CONFIRMATION_TTL_SECONDS=600
CONFIRMATION_PROCESSING_TIMEOUT_SECONDS=30
CONFIRMATION_RECOVERY_POLL_INTERVAL_MS=5000
GATEWAY_WORKFLOW_WORKER_ENABLED=true
GATEWAY_WORKFLOW_POLL_INTERVAL_MS=3000
DEFAULT_TIMEZONE=Asia/Ho_Chi_Minh
DEFAULT_CURRENCY=VND

# ---- Core PostgreSQL Database Credentials (Port 5432) ----
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_ADMIN_USER=xone_admin
POSTGRES_ADMIN_PASSWORD=GENERATE_STRONG_ADMIN_PASSWORD_HERE

CORE_DB_NAME=xone_core
CORE_DB_USER=core_service
CORE_DB_PASSWORD=GENERATE_CORE_DB_PASSWORD_HERE

AGENT_DB_NAME=xone_agent
AGENT_DB_USER=agent_service
AGENT_DB_PASSWORD=GENERATE_AGENT_DB_PASSWORD_HERE

# Database Connection URLs (Chay trong noi bo Docker network)
CORE_DATABASE_URL=postgresql://core_service:GENERATE_CORE_DB_PASSWORD_HERE@postgres:5432/xone_core
AGENT_DATABASE_URL=postgresql://agent_service:GENERATE_AGENT_DB_PASSWORD_HERE@postgres:5432/xone_agent
AGENT_PERSISTENCE_MODE=required_postgres

# ---- Port & Domain Configuration ----
API_GATEWAY_PORT=3000
WEB_PORT=5173

# URL API cong khai cua he thong
NEXT_PUBLIC_API_URL=https://api.yourdomain.com
NEXT_PUBLIC_HERO_VIDEO_URL=
NEXT_PUBLIC_HERO_POSTER_URL=

# CORS Origins
GATEWAY_CORS_ORIGINS=https://yourdomain.com,https://api.yourdomain.com

# ---- Vi tri & Geoapify Provider ----
GEOAPIFY_SERVER_API_KEY=your-geoapify-server-api-key
GEOAPIFY_API_BASE_URL=https://api.geoapify.com/v1
GEOAPIFY_REAL_MODE=true
GEOAPIFY_COUNTRY_FILTER=vn
GEOAPIFY_LANGUAGE=vi
GEOAPIFY_LOCATION_BIAS=proximity:105.85,21.03
NEXT_PUBLIC_GEOAPIFY_MAP_API_KEY=your-geoapify-client-map-key
NEXT_PUBLIC_GEOAPIFY_MAP_STYLE=osm-bright-smooth

LOCATION_PROVIDER_URL=
LOCATION_PROVIDER_TOKEN=
GEOCODING_PROVIDER_URL=
GEOCODING_PROVIDER_TOKEN=
ROUTING_PROVIDER_URL=
ROUTING_PROVIDER_TOKEN=
LOCAL_DETERMINISTIC_LOCATION_FALLBACK=false

# ---- Rate Limiting & DoS Defense ----
GATEWAY_BODY_LIMIT_BYTES=262144
GATEWAY_RATE_LIMIT_WINDOW_SECONDS=60
GATEWAY_AUTH_LOGIN_RATE_LIMIT=5
GATEWAY_ASSISTANT_CHAT_RATE_LIMIT=30
GATEWAY_ASSISTANT_ACTION_RATE_LIMIT=20
GATEWAY_FUTURE_AUTH_RATE_LIMIT=5
GATEWAY_VOICE_TRANSCRIBE_RATE_LIMIT=20
GATEWAY_AUTH_REFRESH_RATE_LIMIT=60
GATEWAY_PROVIDER_SERVICES_RATE_LIMIT=60

# ---- Agent Service (LLM) ----
AGENT_SERVICE_PORT=8001
AGENT_CORS_ORIGINS=http://api-gateway:3000
AGENT_SERVICE_URL=http://agent-service:8001
GEMINI_API_KEY=AIzaSy...
GEMINI_API_KEYS=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_FALLBACK_MODEL=gemini-3.1-flash-lite
AGENT_MODEL_MODE=gemini

# ---- Voice Services ----
OPENAI_API_KEY=
GROQ_API_KEY=

# ---- Observability (Langfuse) ----
LANGFUSE_SECRET_KEY=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_BASE_URL="https://cloud.langfuse.com"

# ---- Logging ----
LOG_LEVEL=INFO

# ---- Google OAuth ----
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=https://api.yourdomain.com/auth/callback/google

# ---- MCP (Model Context Protocol) ----
MCP_ENABLED=true
MCP_SESSION_TTL_SECONDS=1800
GATEWAY_MCP_RPC_RATE_LIMIT=120

# ---- P-018-Service Integration (Independent 7-Container Ecosystem) ----
XONE_SERVICE_MCP_URL=http://mcp-server:8105/sse
XONE_SERVICE_WEB_URL=http://services-web:5174
RIDE_SERVICE_URL=http://ride-service:8101
RESTAURANT_SERVICE_URL=http://restaurant-service:8102
HEALTHCARE_SERVICE_URL=http://healthcare-service:8103
HEALTHCARE_DEFAULT_PATIENT_ID=1
FOOD_SERVICE_URL=http://food-service:8104
