# ============================================
# AI20K Project — Environment Variables
# ============================================
# Copy this file to .env and fill in your values
# NEVER commit .env to git!

# ---- Groq LLM Configuration (optional in local development) ----
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
# OPENAI_API_KEY=  # retained only for compatibility; not used by this agent

# ---- Domain service databases (keep each service isolated) ----
RIDE_DATABASE_URL=sqlite+aiosqlite:///./data/ride/ride.db
PAYMENT_DATABASE_URL=sqlite+aiosqlite:///./data/payment/payment.db
PAYMENT_SERVICE_URL=http://127.0.0.1:8001
# ---- Database ----
DATABASE_URL=postgresql://user:password@localhost:5432/dbname
# For SQLite (development):
# DATABASE_URL=sqlite:///./data/app.db

# ---- Vector Store ----
CHROMA_PERSIST_DIR=./data/chroma
# Or Pinecone:
# PINECONE_API_KEY=
# PINECONE_ENVIRONMENT=

# ---- App Config ----
APP_ENV=development
APP_PORT=8002
APP_HOST=0.0.0.0
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# ---- Ride simulator integration ----
GEOAPIFY_API_KEY=
RIDE_SERVICE_URL=http://127.0.0.1:8000
API_TIMEOUT_SECONDS=10

# ---- LangSmith (AI Logs — Deliverable #4) ----
LANGCHAIN_API_KEY=your-langsmith-key-here
LANGCHAIN_PROJECT=ai20k-agent
LANGCHAIN_TRACING_V2=true

# ---- Logging ----
LOG_LEVEL=INFO

# ---- AI Hook Logging (provided by instructor) ----
AI_LOG_SERVER=https://ai-logs.note.transformerlabs.ai/api/ingest
AI_LOG_API_KEY=f3p1dEOhD_z8qjjtbeCtb2t9ASMEliz-4juZfWe3ZPgCtPZp-LjWthBfeNU8d5dP
AI_LOG_DIR=.ai-log

# ---- Frontend (if separate) ----
# VITE_API_URL=http://localhost:8002
