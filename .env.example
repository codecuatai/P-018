# =============================================================================
# X-One AI Platform — Environment Configuration (.env.example)
# Primary AI Platform (Core Gateway, Web UI, Agent Service, Core PostgreSQL)
# Domain services (Food, Ride, Restaurant, Healthcare) are in P-018-Service.
# =============================================================================

# ── Application & Core Settings ──────────────────────────────────────────────
APP_ENV=development
CORE_AUTO_MIGRATE=true
INTERNAL_SERVICE_TOKEN=replace-with-local-token
JWT_SECRET=replace-with-a-local-jwt-secret-at-least-16-chars
DEFAULT_TIMEZONE=Asia/Ho_Chi_Minh
DEFAULT_CURRENCY=VND

# ── Authentication & Session ──────────────────────────────────────────────────
DEMO_AUTH_ENABLED=true
DEMO_AUTH_EMAIL=demo@example.invalid
DEMO_AUTH_PASSWORD=replace-with-local-demo-password
DEMO_AUTH_USER_ID=usr_demo_001
AUTH_ACCESS_TOKEN_TTL_SECONDS=900
AUTH_REFRESH_TOKEN_TTL_SECONDS=2592000
AUTH_REFRESH_REUSE_GRACE_SECONDS=10
AUTH_RESET_TOKEN_TTL_SECONDS=1800
AUTH_ISSUER=x-one
AUTH_AUDIENCE=x-one-web
AUTH_REFRESH_COOKIE_NAME=xone_refresh
AUTH_DEV_RESET_TOKEN_CAPTURE=true

# ── Gateway Workflow & Recovery ───────────────────────────────────────────────
UPSTREAM_TIMEOUT_MS=5000
CONFIRMATION_TTL_SECONDS=600
CONFIRMATION_PROCESSING_TIMEOUT_SECONDS=30
CONFIRMATION_RECOVERY_POLL_INTERVAL_MS=5000
GATEWAY_WORKFLOW_WORKER_ENABLED=true
GATEWAY_WORKFLOW_POLL_INTERVAL_MS=3000

# ── Core PostgreSQL Container (Port 5432) ────────────────────────────────────
# Manages xone_core and xone_agent. Domain DBs run on P-018-Service (port 5433).
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_ADMIN_USER=postgres
POSTGRES_ADMIN_PASSWORD=replace-with-local-password

CORE_DB_NAME=xone_core
CORE_DB_USER=core_user
CORE_DB_PASSWORD=replace-with-local-password
AGENT_DB_NAME=xone_agent
AGENT_DB_USER=agent_user
AGENT_DB_PASSWORD=replace-with-local-password

CORE_DATABASE_URL=postgresql://core_user:replace-with-local-password@postgres:5432/xone_core
AGENT_DATABASE_URL=postgresql://agent_user:replace-with-local-password@postgres:5432/xone_agent
AGENT_PERSISTENCE_MODE=required_postgres

# ── Gateway & Web Ports ───────────────────────────────────────────────────────
API_GATEWAY_PORT=3000
WEB_PORT=5173
NEXT_PUBLIC_API_URL=http://localhost:3000
NEXT_PUBLIC_HERO_VIDEO_URL=
NEXT_PUBLIC_HERO_POSTER_URL=
GATEWAY_CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ── Geoapify & Location Providers ─────────────────────────────────────────────
GEOAPIFY_SERVER_API_KEY=
GEOAPIFY_API_BASE_URL=https://api.geoapify.com/v1
GEOAPIFY_REAL_MODE=false
GEOAPIFY_COUNTRY_FILTER=vn
GEOAPIFY_LANGUAGE=vi
GEOAPIFY_LOCATION_BIAS=proximity:105.85,21.03
NEXT_PUBLIC_GEOAPIFY_MAP_API_KEY=
NEXT_PUBLIC_GEOAPIFY_MAP_STYLE=osm-bright-smooth

LOCATION_PROVIDER_URL=
LOCATION_PROVIDER_TOKEN=
GEOCODING_PROVIDER_URL=
GEOCODING_PROVIDER_TOKEN=
ROUTING_PROVIDER_URL=
ROUTING_PROVIDER_TOKEN=
LOCAL_DETERMINISTIC_LOCATION_FALLBACK=true

# ── Rate Limits ───────────────────────────────────────────────────────────────
GATEWAY_BODY_LIMIT_BYTES=262144
GATEWAY_RATE_LIMIT_WINDOW_SECONDS=60
GATEWAY_AUTH_LOGIN_RATE_LIMIT=5
GATEWAY_ASSISTANT_CHAT_RATE_LIMIT=30
GATEWAY_ASSISTANT_ACTION_RATE_LIMIT=20
GATEWAY_FUTURE_AUTH_RATE_LIMIT=5
GATEWAY_VOICE_TRANSCRIBE_RATE_LIMIT=20
GATEWAY_AUTH_REFRESH_RATE_LIMIT=60
GATEWAY_PROVIDER_SERVICES_RATE_LIMIT=60

# ── Agent Service & LLM ───────────────────────────────────────────────────────
AGENT_SERVICE_PORT=8001
AGENT_CORS_ORIGINS=http://localhost:3000
AGENT_SERVICE_URL=http://agent-service:8001
GEMINI_API_KEY=
GEMINI_API_KEYS=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_FALLBACK_MODEL=gemini-3.1-flash-lite
AGENT_MODEL_MODE=gemini

# ── Voice Providers (STT/TTS) ─────────────────────────────────────────────────
OPENAI_API_KEY=
GROQ_API_KEY=

# ── Observability & Logging ───────────────────────────────────────────────────
LANGFUSE_SECRET_KEY=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_BASE_URL="https://us.cloud.langfuse.com"
LOG_LEVEL=INFO
AI_LOG_SERVER=https://ai-logs.note.transformerlabs.ai/api/ingest
AI_LOG_API_KEY=replace-with-ai-log-api-key
AI_LOG_DIR=.ai-log

# ── Integrations & Tools ──────────────────────────────────────────────────────
STITCH_API_KEY=replace-with-stitch-api-key
TRELLO_API_KEY=
TRELLO_API_TOKEN=

# ── Google OAuth (Optional Social Sign-In) ─────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3000/auth/callback/google

# ── Model Context Protocol (MCP) ──────────────────────────────────────────────
MCP_ENABLED=true
MCP_SESSION_TTL_SECONDS=1800
GATEWAY_MCP_RPC_RATE_LIMIT=120
MCP_DEMO_KEY=xone_mcp_demo_secret_key_provider_001

# ── P-018-Service Integration (Independent 7-Container Ecosystem) ─────────────
# Set these to connect to P-018-Service (running on ports 8101-8105, 5174)
XONE_SERVICE_MCP_URL=http://localhost:8105/sse
XONE_SERVICE_WEB_URL=http://localhost:5174
RIDE_SERVICE_URL=http://ride-service:8101
RESTAURANT_SERVICE_URL=http://restaurant-service:8102
HEALTHCARE_SERVICE_URL=http://healthcare-service:8103
HEALTHCARE_DEFAULT_PATIENT_ID=1
FOOD_SERVICE_URL=http://food-service:8104
