# ==================================================
# X-One local Docker Compose configuration
# Source of truth for the complete local stack. Never commit .env.
# ==================================================

# Shared local configuration
APP_ENV=development
INTERNAL_SERVICE_TOKEN=replace-with-local-token
JWT_SECRET=replace-with-a-local-jwt-secret-at-least-16-chars
DEMO_AUTH_ENABLED=true
DEMO_AUTH_EMAIL=demo@example.invalid
DEMO_AUTH_PASSWORD=replace-with-local-demo-password
DEMO_AUTH_USER_ID=usr_demo_001
UPSTREAM_TIMEOUT_MS=5000
CONFIRMATION_TTL_SECONDS=600
CONFIRMATION_PROCESSING_TIMEOUT_SECONDS=30
CONFIRMATION_RECOVERY_POLL_INTERVAL_MS=1000
GATEWAY_WORKFLOW_WORKER_ENABLED=true
GATEWAY_WORKFLOW_POLL_INTERVAL_MS=500
RESTAURANT_REJECTION_RATE=0
RESTAURANT_FORCE_RESULT=
DEFAULT_TIMEZONE=Asia/Bangkok
DEFAULT_CURRENCY=VND

# PostgreSQL container
POSTGRES_HOST=postgres
POSTGRES_ADMIN_USER=postgres
POSTGRES_ADMIN_PASSWORD=replace-with-local-password

CORE_DB_NAME=xone_core
CORE_DB_USER=core_user
CORE_DB_PASSWORD=replace-with-local-password
AGENT_DB_NAME=xone_agent
AGENT_DB_USER=agent_user
AGENT_DB_PASSWORD=replace-with-local-password
RIDE_DB_NAME=xone_ride
RIDE_DB_USER=ride_user
RIDE_DB_PASSWORD=replace-with-local-password
RESTAURANT_DB_NAME=xone_restaurant
RESTAURANT_DB_USER=restaurant_user
RESTAURANT_DB_PASSWORD=replace-with-local-password
HEALTHCARE_DB_NAME=xone_healthcare
HEALTHCARE_DB_USER=healthcare_user
HEALTHCARE_DB_PASSWORD=replace-with-local-password
FOOD_DB_NAME=xone_food
FOOD_DB_USER=food_user
FOOD_DB_PASSWORD=replace-with-local-password

# Database URLs used by Docker Compose
CORE_DATABASE_URL=postgresql://core_user:replace-with-local-password@postgres:5432/xone_core
AGENT_DATABASE_URL=postgresql://agent_user:replace-with-local-password@postgres:5432/xone_agent
RIDE_DATABASE_URL=postgresql://ride_user:replace-with-local-password@postgres:5432/xone_ride
RESTAURANT_DATABASE_URL=postgresql://restaurant_user:replace-with-local-password@postgres:5432/xone_restaurant
HEALTHCARE_DATABASE_URL=postgresql://healthcare_user:replace-with-local-password@postgres:5432/xone_healthcare
FOOD_DATABASE_URL=postgresql://food_user:replace-with-local-password@postgres:5432/xone_food

# Service ports and internal URLs
API_GATEWAY_PORT=3000
AGENT_SERVICE_PORT=8001
RIDE_SERVICE_PORT=8101
RESTAURANT_SERVICE_PORT=8102
HEALTHCARE_SERVICE_PORT=8103
FOOD_SERVICE_PORT=8104
AGENT_CORS_ORIGINS=http://localhost:3000
AGENT_SERVICE_URL=http://agent-service:8001
RIDE_SERVICE_URL=http://ride-service:8101
RESTAURANT_SERVICE_URL=http://restaurant-service:8102
HEALTHCARE_SERVICE_URL=http://healthcare-service:8103
FOOD_SERVICE_URL=http://food-service:8104

# AI provider (only agent-service receives these values)
GEMINI_API_KEY=replace-with-gemini-api-key
GEMINI_MODEL=gemini-3.5-flash-lite
API_GATEWAY_INTERNAL_URL=http://api-gateway:3000

# Food domain runtime configuration
FOOD_PERSISTENCE=postgres
DELIVERY_BASE_FEE=15000
DELIVERY_PER_KM_FEE=5000
DELIVERY_MINIMUM_FEE=15000
DELIVERY_MAX_DISTANCE_KM=15
DELIVERY_LONG_DISTANCE_THRESHOLD_KM=5
DELIVERY_LONG_DISTANCE_SURCHARGE=5000
DELIVERY_ETA_MINUTES=35
FOOD_RESTAURANT_CONFIRM_DELAY_MS=3000
FOOD_PREPARING_DELAY_MS=5000
FOOD_READY_FOR_PICKUP_DELAY_MS=3000
FOOD_DRIVER_ASSIGN_DELAY_MS=3000
FOOD_PICKUP_DELAY_MS=3000
FOOD_DELIVERY_DELAY_MS=5000
FOOD_WORKFLOW_POLL_INTERVAL_MS=500
FOOD_WORKFLOW_WORKER_ENABLED=true
