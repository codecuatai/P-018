# ==================================================
# X-One local Docker Compose configuration
# Source of truth for the complete local stack. Never commit .env.
# ==================================================

# Shared local configuration
APP_ENV=development
CORE_AUTO_MIGRATE=true
INTERNAL_SERVICE_TOKEN=replace-with-local-token
JWT_SECRET=replace-with-a-local-jwt-secret-at-least-16-chars
DEMO_AUTH_ENABLED=true
DEMO_AUTH_EMAIL=demo@example.invalid
DEMO_AUTH_PASSWORD=replace-with-local-demo-password
DEMO_AUTH_USER_ID=usr_demo_001
AUTH_ACCESS_TOKEN_TTL_SECONDS=900
AUTH_REFRESH_TOKEN_TTL_SECONDS=2592000
AUTH_REFRESH_REUSE_GRACE_SECONDS=10
AUTH_RESET_TOKEN_TTL_SECONDS=1800
AUTH_ISSUER=x-one
AUTH_AUDIENCE=x-one-web
AUTH_REFRESH_COOKIE_NAME=xone_refresh
AUTH_DEV_RESET_TOKEN_CAPTURE=true
UPSTREAM_TIMEOUT_MS=5000
CONFIRMATION_TTL_SECONDS=600
CONFIRMATION_PROCESSING_TIMEOUT_SECONDS=30
CONFIRMATION_RECOVERY_POLL_INTERVAL_MS=5000
GATEWAY_WORKFLOW_WORKER_ENABLED=true
GATEWAY_WORKFLOW_POLL_INTERVAL_MS=3000
RESTAURANT_REJECTION_RATE=0
RESTAURANT_FORCE_RESULT=
DEFAULT_TIMEZONE=Asia/Ho_Chi_Minh
DEFAULT_CURRENCY=VND

# PostgreSQL container
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_ADMIN_USER=postgres
POSTGRES_ADMIN_PASSWORD=replace-with-local-password

CORE_DB_NAME=xone_core
CORE_DB_USER=core_user
CORE_DB_PASSWORD=replace-with-local-password
AGENT_DB_NAME=xone_agent
AGENT_DB_USER=agent_user
AGENT_DB_PASSWORD=replace-with-local-password
RIDE_DB_NAME=xone_ride
RIDE_DB_USER=ride_user
RIDE_DB_PASSWORD=replace-with-local-password
RESTAURANT_DB_NAME=xone_restaurant
RESTAURANT_DB_USER=restaurant_user
RESTAURANT_DB_PASSWORD=replace-with-local-password
HEALTHCARE_DB_NAME=xone_healthcare
HEALTHCARE_DB_USER=healthcare_user
HEALTHCARE_DB_PASSWORD=replace-with-local-password
FOOD_DB_NAME=xone_food
FOOD_DB_USER=food_user
FOOD_DB_PASSWORD=replace-with-local-password

# Database URLs used by Docker Compose
CORE_DATABASE_URL=postgresql://core_user:replace-with-local-password@postgres:5432/xone_core
AGENT_DATABASE_URL=postgresql://agent_user:replace-with-local-password@postgres:5432/xone_agent
AGENT_PERSISTENCE_MODE=required_postgres
RIDE_DATABASE_URL=postgresql://ride_user:replace-with-local-password@postgres:5432/xone_ride
RESTAURANT_DATABASE_URL=postgresql://restaurant_user:replace-with-local-password@postgres:5432/xone_restaurant
HEALTHCARE_DATABASE_URL=postgresql://healthcare_user:replace-with-local-password@postgres:5432/xone_healthcare
FOOD_DATABASE_URL=postgresql://food_user:replace-with-local-password@postgres:5432/xone_food

# Service ports and internal URLs
API_GATEWAY_PORT=3000
WEB_PORT=5173
NEXT_PUBLIC_API_URL=http://localhost:3000
NEXT_PUBLIC_HERO_VIDEO_URL=
NEXT_PUBLIC_HERO_POSTER_URL=
GATEWAY_CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ============================================================
# Geoapify — optional local provider integration
# ============================================================
# Server-only key. Never expose this value to the browser or logs. Keep real
# mode disabled when it is blank; deterministic fallback remains labelled.
GEOAPIFY_SERVER_API_KEY=
GEOAPIFY_API_BASE_URL=https://api.geoapify.com/v1
GEOAPIFY_REAL_MODE=false
GEOAPIFY_COUNTRY_FILTER=vn
GEOAPIFY_LANGUAGE=vi
GEOAPIFY_LOCATION_BIAS=proximity:105.85,21.03
NEXT_PUBLIC_GEOAPIFY_MAP_API_KEY=
NEXT_PUBLIC_GEOAPIFY_MAP_STYLE=osm-bright-smooth

LOCATION_PROVIDER_URL=
LOCATION_PROVIDER_TOKEN=
GEOCODING_PROVIDER_URL=
GEOCODING_PROVIDER_TOKEN=
ROUTING_PROVIDER_URL=
ROUTING_PROVIDER_TOKEN=
# Development-only deterministic coordinates for local E2E/demo addresses.
LOCAL_DETERMINISTIC_LOCATION_FALLBACK=true
GATEWAY_BODY_LIMIT_BYTES=262144
GATEWAY_RATE_LIMIT_WINDOW_SECONDS=60
GATEWAY_AUTH_LOGIN_RATE_LIMIT=5
GATEWAY_ASSISTANT_CHAT_RATE_LIMIT=30
GATEWAY_ASSISTANT_ACTION_RATE_LIMIT=20
GATEWAY_FUTURE_AUTH_RATE_LIMIT=5
GATEWAY_VOICE_TRANSCRIBE_RATE_LIMIT=20
GATEWAY_AUTH_REFRESH_RATE_LIMIT=60
GATEWAY_PROVIDER_SERVICES_RATE_LIMIT=60
AGENT_SERVICE_PORT=8001
RIDE_SERVICE_PORT=8101
# Local/E2E only: wall-clock multiplier for the synthetic Ride tracking simulator.
# Production must keep the service-level TRACKING_TIME_SCALE at 1.0.
RIDE_TRACKING_TIME_SCALE=3
RESTAURANT_SERVICE_PORT=8102
HEALTHCARE_SERVICE_PORT=8103
FOOD_SERVICE_PORT=8104
AGENT_CORS_ORIGINS=http://localhost:3000
AGENT_SERVICE_URL=http://agent-service:8001
RIDE_SERVICE_URL=http://ride-service:8101
RESTAURANT_SERVICE_URL=http://restaurant-service:8102
HEALTHCARE_SERVICE_URL=http://healthcare-service:8103
HEALTHCARE_DEFAULT_PATIENT_ID=1
HEALTHCARE_FACILITY_NAME=X-One Healthcare Clinic
HEALTHCARE_FACILITY_ADDRESS=12 Nguyen Trai, Thanh Xuan, Ha Noi
FOOD_SERVICE_URL=http://food-service:8104

# AI provider (only agent-service receives these values)
# Offline/local development runs deterministically with this blank. Gate G2
# real-LLM evaluation requires a valid key and AGENT_MODEL_MODE=gemini.
# Multiple comma-separated keys enable round-robin load balancing and failover: key1,key2,key3
GEMINI_API_KEY=
GEMINI_API_KEYS=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_FALLBACK_MODEL=gemini-3.1-flash-lite
AGENT_MODEL_MODE=gemini

# Provider keys for Voice features (STT/TTS)
OPENAI_API_KEY=#dùng cho model TTS-1 (Text to speech)
GROQ_API_KEY=#dùng cho model Whisper(Speech to text)

# Langfuse (Optional AI agent observability and trace monitoring)
LANGFUSE_SECRET_KEY=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_BASE_URL="https://us.cloud.langfuse.com"

# Stitch (UI design tool — MCP integration for AI coding agents)
STITCH_API_KEY=replace-with-stitch-api-key

# QA evidence upload helper (host-only; never mapped into Compose or browser code)
TRELLO_API_KEY=
TRELLO_API_TOKEN=

# Food domain runtime configuration
FOOD_PERSISTENCE=postgres
DELIVERY_BASE_FEE=15000
DELIVERY_PER_KM_FEE=5000
DELIVERY_MINIMUM_FEE=15000
DELIVERY_MAX_DISTANCE_KM=15
DELIVERY_LONG_DISTANCE_THRESHOLD_KM=5
DELIVERY_LONG_DISTANCE_SURCHARGE=5000
DELIVERY_ETA_MINUTES=35
FOOD_RESTAURANT_CONFIRM_DELAY_MS=3000
FOOD_PREPARING_DELAY_MS=5000
FOOD_READY_FOR_PICKUP_DELAY_MS=3000
FOOD_DRIVER_ASSIGN_DELAY_MS=3000
FOOD_PICKUP_DELAY_MS=3000
FOOD_DELIVERY_DELAY_MS=5000
FOOD_WORKFLOW_POLL_INTERVAL_MS=3000
FOOD_WORKFLOW_WORKER_ENABLED=true

# ---- Logging ----
LOG_LEVEL=INFO

# ---- Google OAuth (Optional Social Sign-In) ----
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3000/auth/callback/google

# ---- AI Hook Logging (optional local developer integration) ----
AI_LOG_SERVER=https://ai-logs.note.transformerlabs.ai/api/ingest
AI_LOG_API_KEY=replace-with-ai-log-api-key
AI_LOG_DIR=.ai-log
