# This file is only for running this service independently.
# For the complete local stack, use the root .env file with Docker Compose.
APP_ENV=development
SERVICE_PORT=8001
DATABASE_URL=postgresql://agent_user:replace-with-local-password@localhost:5432/xone_agent
AGENT_PERSISTENCE_MODE=memory
# Leave blank for deterministic local development. A real-LLM evaluation needs
# a valid key together with AGENT_MODEL_MODE=gemini.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_FALLBACK_MODEL=gemini-3.1-flash-lite
AGENT_MODEL_MODE=gemini
# Langfuse is optional and auto-enables only when both keys are present.
LANGFUSE_SECRET_KEY=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_BASE_URL="https://us.cloud.langfuse.com"
INTERNAL_SERVICE_TOKEN=replace-with-local-token
CORS_ORIGINS=http://localhost:3000
