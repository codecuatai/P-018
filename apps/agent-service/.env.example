# This file is only for running this service independently.
# For the complete local stack, use the root .env file with Docker Compose.
APP_ENV=development
SERVICE_PORT=8001
DATABASE_URL=postgresql://agent_user:replace-with-local-password@localhost:5432/xone_agent
GEMINI_API_KEY=replace-with-gemini-api-key
GEMINI_MODEL=replace-with-supported-model
INTERNAL_SERVICE_TOKEN=replace-with-local-token
CORS_ORIGINS=http://localhost:3000
