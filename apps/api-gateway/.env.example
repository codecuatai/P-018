# This file is only for running this service independently.
# For the complete local stack, use the root .env file with Docker Compose.
PORT=3000
DATABASE_URL=postgresql://core_user:replace-with-local-password@localhost:5432/xone_core
AGENT_SERVICE_URL=http://localhost:8001
RIDE_SERVICE_URL=http://localhost:8101
RESTAURANT_SERVICE_URL=http://localhost:8102
HEALTHCARE_SERVICE_URL=http://localhost:8103
FOOD_SERVICE_URL=http://localhost:8104
INTERNAL_SERVICE_TOKEN=replace-with-local-token
JWT_SECRET=replace-with-a-local-jwt-secret-at-least-16-chars
UPSTREAM_TIMEOUT_MS=5000
CONFIRMATION_TTL_SECONDS=600
CONFIRMATION_PROCESSING_TIMEOUT_SECONDS=30
CONFIRMATION_RECOVERY_POLL_INTERVAL_MS=1000
GATEWAY_WORKFLOW_WORKER_ENABLED=false
GATEWAY_WORKFLOW_POLL_INTERVAL_MS=500
RESTAURANT_REJECTION_RATE=0.05
