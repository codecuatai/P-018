# This file is only for running this service independently.
# For the complete local stack, use the root .env file with Docker Compose.
SERVICE_PORT=8104
DATABASE_URL=postgresql://food_user:replace-with-local-password@localhost:5432/xone_food
INTERNAL_SERVICE_TOKEN=replace-with-local-token
PERSISTENCE=postgres
DELIVERY_BASE_FEE=15000
DELIVERY_PER_KM_FEE=5000
DELIVERY_MINIMUM_FEE=15000
DELIVERY_MAX_DISTANCE_KM=15
DELIVERY_LONG_DISTANCE_THRESHOLD_KM=5
DELIVERY_LONG_DISTANCE_SURCHARGE=5000
DELIVERY_ETA_MINUTES=35
FOOD_RESTAURANT_CONFIRM_DELAY_MS=3000
FOOD_PREPARING_DELAY_MS=5000
FOOD_READY_FOR_PICKUP_DELAY_MS=3000
FOOD_DRIVER_ASSIGN_DELAY_MS=3000
FOOD_PICKUP_DELAY_MS=3000
FOOD_DELIVERY_DELAY_MS=5000
FOOD_WORKFLOW_POLL_INTERVAL_MS=500
FOOD_WORKFLOW_WORKER_ENABLED=true
RESTAURANT_REJECTION_RATE=0.05
