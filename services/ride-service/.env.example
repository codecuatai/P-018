# This file is only for running this service independently.
# For the complete local stack, use the root .env file with Docker Compose.
SERVICE_PORT=8101
DATABASE_URL=postgresql://ride_user:replace-with-local-password@localhost:5432/xone_ride
INTERNAL_SERVICE_TOKEN=replace-with-local-token
# Normal local tracking is real-time. Set this explicitly for accelerated
# development/test simulations only; production must remain at 1.0.
TRACKING_TIME_SCALE=1.0
