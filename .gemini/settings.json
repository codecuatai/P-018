{
  "mcpServers": {
    "stitch": {
      "command": "npx",
      "args": ["-y", "@_davideast/stitch-mcp@latest", "proxy"],
      "env": {
        "STITCH_API_KEY": "$STITCH_API_KEY"
      }
    }
  },
  "hooks": {
    "BeforeAgent": [
      {
        "hooks": [
          {
            "name": "log-prompt",
            "type": "command",
            "command": "scripts\\ai-logging\\_pyrun.cmd scripts\\ai-logging\\log_hook.py --tool=gemini",
            "timeout": 10000
          }
        ]
      }
    ],
    "AfterModel": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "name": "log-model",
            "type": "command",
            "command": "scripts\\ai-logging\\_pyrun.cmd scripts\\ai-logging\\log_hook.py --tool=gemini",
            "timeout": 10000
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "name": "log-session-end",
            "type": "command",
            "command": "scripts\\ai-logging\\_pyrun.cmd scripts\\ai-logging\\log_hook.py --tool=gemini",
            "timeout": 10000
          }
        ]
      }
    ]
  }
}
