{
  "mcpServers": {
    "stitch": {
      "command": "npx",
      "args": ["-y", "@_davideast/stitch-mcp@latest", "proxy"],
      "env": {
        "STITCH_API_KEY": "AQ.Ab8RN6KMdbGYcCF9SDTcXa-f9_nJUD5RFSkMS4bAM1Izm-2D1A"
      }
    }
  },
  "hooks": {
    "BeforeAgent": [
      {
        "hooks": [
          {
            "name": "log-prompt",
            "type": "command",
            "command": "scripts\\_pyrun.cmd scripts\\log_hook.py --tool=gemini",
            "timeout": 10000
          }
        ]
      }
    ],
    "AfterModel": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "name": "log-model",
            "type": "command",
            "command": "scripts\\_pyrun.cmd scripts\\log_hook.py --tool=gemini",
            "timeout": 10000
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "name": "log-session-end",
            "type": "command",
            "command": "scripts\\_pyrun.cmd scripts\\log_hook.py --tool=gemini",
            "timeout": 10000
          }
        ]
      }
    ]
  }
}
